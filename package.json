{
  "name": "miniature-studio",
  "private": true,
  "version": "2.2.0",
  "type": "module",
  "workspaces": [
    "mcp"
  ],
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && npm run typecheck -w miniature-studio-mcp",
    "check": "npm run typecheck && npm test && npm run build",
    "build:mcp": "npm run build -w miniature-studio-mcp",
    "feed:update": "node scripts/update-feed-videos.ts",
    "fonts:download": "node scripts/download-fonts.ts",
    "build:local": "esbuild local/server.ts --bundle --platform=node --format=esm --target=node22 --outfile=local/dist/server.mjs",
    "local": "npm run build && npm run build:local && node local/dist/server.mjs",
    "app:mac": "npm run build && npm run build:local && sh macos/build.sh",
    "app:mac:install": "npm run app:mac && sh macos/build.sh --install"
  },
  "dependencies": {
    "@astrojs/react": "^7.0.0",
    "@fontsource-variable/fredoka": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource/roboto": "^5.2.9",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "fflate": "^0.8.3",
    "idb": "^8.0.3",
    "lucide": "^1.48.0",
    "lucide-react": "^1.48.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-resizable-panels": "^4.13.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/ts-plugin": "^1.10.0",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22"
  }
}
